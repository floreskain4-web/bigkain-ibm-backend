name: Deploy BigKain Backend to IBM Code Engine
on:
  push:
    branches:
      - main
    paths-ignore:
      - 'README.md'
      - 'site/**'
      - '.github/workflows/pages.yml'
      - '.github/workflows/deploy-ibm-code-engine.yml'
  workflow_dispatch:

permissions:
  contents: read and write 

jobs:
  deploy:
    name: Build & Deploy
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Repository
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2

      - name: Validate required secrets
        env:
          IBM_API_KEY: ${{ secrets.IBMCLOUD_API_KEY }}
          IBM_REGION: ${{ secrets.IBM_REGION }}
          IBM_PROJECT: ${{ secrets.IBM_PROJECT }}
          IBM_RESOURCE_GROUP: ${{ secrets.IBM_RESOURCE_GROUP }}
        run: |
          set -euo pipefail
          if [ -z "${IBM_API_KEY:-}" ]; then
            echo "::error::IBMCLOUD_API_KEY secret is missing or empty"
            exit 1
          fi
          echo "IBMCLOUD_API_KEY is present"
          echo "IBM_REGION=${IBM_REGION:-us-south (default)}"
          echo "IBM_PROJECT=${IBM_PROJECT:-(not set)}"
          echo "IBM_RESOURCE_GROUP=${IBM_RESOURCE_GROUP:-(not set)}"

      - name: Install IBM Cloud CLI
        run: |
          set -euo pipefail
          curl -fsSL https://clis.cloud.ibm.com/install/linux | sh
          ibmcloud plugin install code-engine -f
          ibmcloud plugin install container-registry -f
          ibmcloud version

      - name: Authenticate and select project
        env:
          IBM_API_KEY: ${{ secrets.IBMCLOUD_API_KEY }}
          IBM_REGION: ${{ secrets.IBM_REGION }}
          IBM_PROJECT: ${{ secrets.IBM_PROJECT }}
          IBM_RESOURCE_GROUP: ${{ secrets.IBM_RESOURCE_GROUP }}
        run: |
          set -euo pipefail
          REGION="${IBM_REGION:-us-south}"
          echo "Logging in to region: $REGION"
          ibmcloud login --apikey "$IBM_API_KEY" -r "$REGION"

          if [ -n "${IBM_RESOURCE_GROUP:-}" ]; then
            echo "Selecting resource group: $IBM_RESOURCE_GROUP"
            ibmcloud target -g "$IBM_RESOURCE_GROUP"
          fi

          if [ -n "${IBM_PROJECT:-}" ]; then
            echo "Selecting Code Engine project: $IBM_PROJECT"
            ibmcloud ce project select --name "$IBM_PROJECT" || \
              ibmcloud ce project select --id "$IBM_PROJECT"
          else
            echo "No IBM_PROJECT secret set – using current target project"
            ibmcloud ce project current || true
          fi

          ibmcloud target
          ibmcloud cr login

      - name: Build and Push Container Image
        env:
          IMAGE_NAME: icr.io/bigkain/bigkain-backend
          COMMIT_SHA: ${{ github.sha }}
        run: |
          set -euo pipefail
          COMMIT_TAG="${IMAGE_NAME}:${COMMIT_SHA}"
          LATEST_TAG="${IMAGE_NAME}:latest"
          echo "Building $COMMIT_TAG and $LATEST_TAG"
          docker build --platform linux/amd64 -t "$COMMIT_TAG" -t "$LATEST_TAG" .
          docker push "$COMMIT_TAG"
          docker push "$LATEST_TAG"
          echo "Pushed $COMMIT_TAG and $LATEST_TAG"

      - name: Deploy Application to Code Engine
        id: deploy
        run: |
          set -euo pipefail
          IMAGE="icr.io/bigkain/bigkain-backend:latest"
          APP_NAME="bigkain-backend"

          if ibmcloud ce app get --name "$APP_NAME" >/dev/null 2>&1; then
            echo "App exists – updating image and waiting for ready state"
            ibmcloud ce app update --name "$APP_NAME" \
              --image "$IMAGE" \
              --wait
          else
            echo "App not found – creating with wait"
            ibmcloud ce app create --name "$APP_NAME" \
              --image "$IMAGE" \
              --cpu 0.5 \
              --memory 1G \
              --min-scale 0 \
              --max-scale 2 \
              --port 8080 \
              --wait
          fi

      - name: Confirm deployment
        run: |
          set -euo pipefail
          APP_NAME="bigkain-backend"
          echo "=== Deployment confirmation ==="
          ibmcloud ce app get --name "$APP_NAME" --output json | jq '{name: .metadata.name, status: .status.phase, url: .status.url, ready: .status.ready}'
          URL=$(ibmcloud ce app get --name "$APP_NAME" --output json | jq -r '.status.url // empty')
          if [ -z "$URL" ]; then
            echo "::error::No application URL returned after deploy"
            exit 1
          fi
          echo "Application URL: $URL"
          echo "APP_URL=$URL" >> "$GITHUB_ENV"
          echo "Deploy step completed. Live health check against the IBM endpoint is still required before marking GREEN."
